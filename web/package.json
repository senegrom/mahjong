{
  "name": "riichi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser riichi mahjong on the EMA 2025 rules",
  "scripts": {
    "wasm": "wasm-pack build ../engine/riichi-wasm --target web --out-dir ../../web/src/wasm --out-name riichi",
    "dev": "node scripts/copy-runtime.mjs && vite",
    "build": "node scripts/copy-runtime.mjs && vite build",
    "check": "svelte-check --no-tsconfig --fail-on-warnings",
    "verify": "npm audit --audit-level=low && npm run wasm && npm run lint && npm run check && npm run build && npm run test:unit && npm run test:browser && npm run check:icons",
    "check:icons": "node scripts/check-icons.mjs && node scripts/check-icons.mjs --built",
    "test:unit": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-suite.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "puppeteer-core": "^25.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
