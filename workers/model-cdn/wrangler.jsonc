{
  // Serves the trained network out of R2 (workers/model-cdn/src/index.js).
  //
  //   npx wrangler deploy --config workers/model-cdn/wrangler.jsonc
  //
  // The bucket holds one object per export under models/<generation>/,
  // written by web/scripts/publish-model-r2.mjs. Nothing here is secret: the
  // bucket is private and reachable only through this Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahjong-model",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  // The network is immutable and served straight from R2; there is nothing
  // to keep warm and no state to hold between requests.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "mahjong-models"
    }
  ]
}
