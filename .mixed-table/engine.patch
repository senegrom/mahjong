+    /// Creates a custom table. The order is right, opposite, left relative
+    /// to the human, and those people retain their controllers all match.
+    /// No extra random draws: a uniform assignment exactly matches `new`.
+    pub fn with_opponents(seed: f64, right: &str, across: &str, left: &str) -> Result<Game, JsValue> {
+        let mut assigned = [Controller::Club; 3];
+        for (index, name) in [right, across, left].iter().enumerate() {
+            assigned[index] = Controller::parse(name)
+                .ok_or_else(|| JsValue::from_str("invalid opponent type"))?;
+        }
+        let mut game = Game::new(seed, Some("club".into()));
+        for (index, controller) in assigned.iter().enumerate() {
+            let who = (game.player + index + 1) % 4;
+            game.controllers[who] = *controller;
+            game.bots[who] = Bot::with_style((seed as u64).wrapping_add(who as u64), controller.style());
+        }
+        game.refresh_external();
+        Ok(game)
+    }
