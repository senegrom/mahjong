+        let human = game.player;
+        let controllers = game.controllers;
+        for _ in 0..8 {
+            for offset in 1..4 {
+                let who = game.hand_seating[game.seat.plus(offset).index()];
+                assert_eq!(who, (human + offset) % 4);
+                assert_eq!(game.controllers[who], controllers[who]);
+            }
+            game.hand.phase = Phase::Over;
+            game.hand.outcome = Some(Outcome::ExhaustiveDraw { tenpai: Vec::new() });
+            game.next_hand().unwrap();
+        }
+        assert!(game.table.finished);
+        assert_eq!(game.controllers, controllers);
+        assert_eq!(game.hand_seating[game.seat.index()], human);
