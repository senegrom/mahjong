+    /// Gather native responses without treating any trained player as a pass.
+    /// The human is asked first (as in historical saves), then all remaining
+    /// controllers answer before the core resolves Ron/Pon/Chii priority.
+    fn begin_mixed_calls(&mut self, offered: &[(Wind, Vec<Call>)], human: Option<Call>) -> Result<(), JsValue> {
+        self.asking.clear();
+        self.gathered.clear();
+        if let Some(call) = human {
+            self.gathered.push((self.seat, call));
+            if !matches!(call, Call::Pass) { self.note(self.seat, &describe_call(call).label); }
+        }
+        for (seat, calls) in offered {
+            if *seat == self.seat { continue; }
+            if self.external_for(*seat) {
+                self.asking.push(*seat);
+            } else {
+                let who = self.hand_seating[seat.index()];
+                let call = self.bots[who].call(&self.hand, *seat, calls);
+                self.gathered.push((*seat, call));
+                if !matches!(call, Call::Pass) { self.note(*seat, &describe_call(call).label); }
+            }
+        }
+        if self.asking.is_empty() {
+            let answers = std::mem::take(&mut self.gathered);
+            self.hand.resolve_calls(&answers).map_err(refused)?;
+        }
+        Ok(())
+    }
