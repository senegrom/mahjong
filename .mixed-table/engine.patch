+    fn external_for(&self, seat: Wind) -> bool {
+        seat != self.seat && self.controllers[self.hand_seating[seat.index()]] == Controller::Neural
+    }
+
+    fn refresh_external(&mut self) {
+        self.external = self.controllers.iter().enumerate()
+            .any(|(who, controller)| who != self.player && *controller == Controller::Neural);
+    }
