# What this repository's builds, tests and tools write, and local files that
# never belong in it. A rule without a leading slash matches at any depth, so
# a generic directory name here would hide a source directory of that name.

# Cargo's output, for the root workspace and for engine/libriichi, which is a
# workspace of its own: unanchored so that it matches both.
target/

# Python bytecode and extension modules (`*.py[codz]` includes `.pyd`), and
# the caches of Python tools run from the repository.
__pycache__/
*.py[codz]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments, and the secrets they may hold.
.venv
venv/
.env
.envrc

# Wheels built locally the way the training image builds them
# (`maturin build --out wheels`).
wheels/

# Training runs started from the repository root: the documented
# `--out runs/...` writes checkpoints, logs and a replay ring of several
# gigabytes.
/runs/

# npm's packages, and build output (Vite writes web/dist).
node_modules/
dist/

# Generated WebAssembly package (built by `npm run wasm`)
web/src/wasm/

# Copied from the package at build time, not source.
web/public/ort/

# Browser UI regression evidence
web/test-results/

# Temporary fixtures of the tile-effect and hot-reload browser checks
web/.tile-effects-*/

# Wrangler's local state, beside workers/model-cdn/wrangler.jsonc.
.wrangler/

# Logs of local runs.
*.log
